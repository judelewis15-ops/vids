diff --git a/backend/scripts/claude_compat.py b/backend/scripts/claude_compat.py
new file mode 100644
index 0000000..da8b577
--- /dev/null
+++ b/backend/scripts/claude_compat.py
@@ -0,0 +1,40 @@
+"""
+Claude support for the OASIS simulation scripts.
+
+camel's OpenAI backend counts tokens with tiktoken, which downloads its
+encoding files on first use. That download is unnecessary (and may be
+blocked) when the model is Claude, so Claude models get an approximate
+character-based counter instead.
+"""
+
+from typing import List, Optional
+
+from camel.utils.token_counting import BaseTokenCounter
+
+
+class ApproxTokenCounter(BaseTokenCounter):
+    """Estimates tokens as roughly four characters each; no downloads."""
+
+    CHARS_PER_TOKEN = 4
+
+    def count_tokens_from_messages(self, messages) -> int:
+        total = 0
+        for message in messages:
+            content = message.get("content") or ""
+            if not isinstance(content, str):
+                content = str(content)
+            total += len(content) // self.CHARS_PER_TOKEN + 4
+        return total
+
+    def encode(self, text: str) -> List[int]:
+        return list(text.encode("utf-8"))
+
+    def decode(self, token_ids: List[int]) -> str:
+        return bytes(token_ids).decode("utf-8", errors="ignore")
+
+
+def token_counter_for(model_name: Optional[str]) -> Optional[BaseTokenCounter]:
+    """Return a counter for Claude models, or None to keep camel's default."""
+    if model_name and model_name.strip().lower().startswith("claude"):
+        return ApproxTokenCounter()
+    return None
